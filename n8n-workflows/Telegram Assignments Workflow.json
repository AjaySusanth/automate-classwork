      "id": "d0b7b566-f1b5-4365-98d3-412ccf769b16",
      "name": "Fetch Pending Assignments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -496,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Read input\nconst input = $input.first().json;\nconst assignments = input.assignments;\n\n// Config\nconst chatId = $node[\"Telegram Trigger\"].json.message.chat.id;\nconst baseUrl = 'http://localhost:3000';\n\n// Build formatted message text\nlet message = `📋 Your Pending Assignments (${assignments.length}):\\n\\n`;\n\nassignments.forEach((a, index) => {\n  const dueDate = new Date(a.dueDate).toLocaleDateString('en-US');\n  message += `${index + 1}️⃣ ${a.title}\\n`;\n  message += `Due: ${dueDate}\\n\\n`;\n});\n\n// Build inline keyboard (one button per row)\nconst inlineKeyboard = assignments.map(a => ([\n  {\n    text: `🚀 Submit: ${a.title}`,\n    url: `${baseUrl}/student/assignments/${a.id}/submit`\n  }\n]));\n\n// Return Telegram-ready payload\nreturn [\n  {\n    json: {\n      chat_id: chatId,\n      text: message,\n      parse_mode: 'Markdown',\n      reply_markup: {\n        inline_keyboard: inlineKeyboard\n      }\n    }\n  }\n];\n"
      },
      "id": "900e9f65-3dce-4391-af1a-57b9677b4779",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "❌ Invalid command. Please use /assignments to view your pending assignments.",
        "additionalFields": {}
      },
      "id": "8c7deaec-9b18-442f-a36d-107b34cea283",
      "name": "Send Error Message",
