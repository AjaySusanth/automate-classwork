      "parameters": {
        "jsCode": "const text = ($json.message?.text || \"\").trim();\nconst chatId = String($json.message?.chat?.id || \"\");\n\n// Defaults\nlet commandType = \"unknown\";\nlet token = \"\";\n\n// Command parsing\nif (text.startsWith(\"/start\")) {\n  commandType = \"start\";\n  const parts = text.split(/\\s+/);\n  token = parts.length > 1 ? parts[1] : \"\";\n} else if (text === \"/assignments\") {\n  commandType = \"assignments\";\n} else if (text === \"/help\") {\n  commandType = \"help\";\n}\n\nreturn {\n  commandType,\n  token,\n  chatId,\n  originalMessage: text\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
