    {
      "parameters": {
        "jsCode": "// Read input\nconst input = $input.first().json;\nconst assignments = input.assignments;\n\n// Config\nconst chatId = $node[\"Trigger – Telegram Message\"].json.message.chat.id;\nconst baseUrl = 'http://localhost:3000';\n\n// Build formatted message text\nlet message = `📋 Your Pending Assignments (${assignments.length}):\\n\\n`;\n\nassignments.forEach((a, index) => {\n  const dueDate = new Date(a.dueDate).toLocaleDateString('en-US');\n  message += `${index + 1}️⃣ ${a.title}\\n`;\n  message += `Due: ${dueDate}\\n\\n`;\n});\n\n// Build inline keyboard (one button per row)\nconst inlineKeyboard = assignments.map(a => ([\n  {\n    text: `🚀 Submit: ${a.title}`,\n    url: `${baseUrl}/student/assignments/${a.id}/submit`\n  }\n]));\n\n// Return Telegram-ready payload\nreturn [\n  {\n    json: {\n      chat_id: chatId,\n      text: message,\n      parse_mode: 'Markdown',\n      reply_markup: {\n        inline_keyboard: inlineKeyboard\n      }\n    }\n  }\n];\n"
      },
      "id": "fa9ff061-6900-4169-9637-91c594fa8746",
